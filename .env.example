# Neon Postgres. Use the pooled connection string from the Neon dashboard.
# This is a server secret: it must never appear in browser code.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate the secret with:  npx auth secret
AUTH_SECRET=""

# Admin accounts are usernames and passwords kept in the site_admins table.
# There is no sign-up form and nothing to configure here: create the first
# account from the command line with
#     npm run admin:add
# The password is typed hidden and only its scrypt hash is stored.

# Vercel Blob, for uploaded photos and PDFs.
# Created for you when you add a Blob store to the project on Vercel.
BLOB_READ_WRITE_TOKEN=""
