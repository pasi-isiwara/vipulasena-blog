{
  "name": "vipulasena-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:schema": "node scripts/run-sql.mjs database/neon-schema.sql",
    "db:seed": "node scripts/run-sql.mjs database/seed-sample-content.sql",
    "db:migrate": "node scripts/run-sql.mjs database/002-sender-hash.sql && node scripts/run-sql.mjs database/003-admin-login.sql",
    "admin:add": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/add-admin.mjs",
    "admin:list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/add-admin.mjs --list",
    "admin:remove": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/add-admin.mjs --remove"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.0.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
